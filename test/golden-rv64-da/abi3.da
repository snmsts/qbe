**** Function test ****
> After ABI lowering:
function $test() {
@start
	%a =w loadsw $z
	%y =w add %a, %a
	%yl =l extsw %y
	%s =l alloc8 16
	%s1 =l add %s, 12
	storel 4, %s
	storew 5, %s1
	%f =l add %yl, $F
	R13 =w copy 6
	%abi.2 =l add %s, 8
	R12 =l load %abi.2
	%abi.1 =l add %s, 0
	R11 =l load %abi.1
	R10 =w copy 3
	R9 =w copy 2
	R8 =w copy 1
	R7 =w copy %y
	call %f, 0071
	%x =w copy R7
	%x1 =w add %y, %x
	storew %x1, $a
	ret0
}

