**** Function test ****
> After ABI lowering:
function $test() {
@start
	%abi.copy.2 =l alloc8 16
	%a =w loadsw $z
	%y =w add %a, %a
	%yl =l extsw %y
	%s =l alloc8 16
	%s1 =l add %s, 12
	storel 4, %s
	storew 5, %s1
	%f =l add %yl, $F
	%abi.args.1 =l salloc 48
	%abi.off.4 =l add %abi.args.1, 40
	storel 6, %abi.off.4
	%abi.off.3 =l add %abi.args.1, 32
	storel %abi.copy.2, %abi.off.3
	blit0 %s, %abi.copy.2
	blit1 16
	R7 =w copy 3
	R6 =w copy 2
	R3 =w copy 1
	R2 =w copy %y
	call %f, 00f1
	%x =w copy R1
	salloc -48
	%x1 =w add %y, %x
	storew %x1, $a
	ret0
}

