**** Function epar ****
> After ABI lowering:
function $epar() {
@start
	%e =l copy R1
	%i =l copy R2
	%x =l add %e, %i
	R1 =l copy %x
	ret0 0001
}

**** Function earg ****
> After ABI lowering:
function $earg() {
@start
	%b =l copy R3
	%a =l copy R2
